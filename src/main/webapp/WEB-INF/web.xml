<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>HRM-Group2</display-name>

    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/assets/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserServlet</servlet-name>
        <servlet-class>com.hrm.project.controller.user.AdminUserList</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserActionServlet</servlet-name>
        <servlet-class>com.hrm.project.controller.user.AdminUserListController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserActionServlet</servlet-name>
        <url-pattern>/admin/users/action</url-pattern>
    </servlet-mapping>

    <!-- =====INSURANCE SERVLET CONFIGURATION ===== -->
    <servlet>
        <servlet-name>AdminInsuranceConfig</servlet-name>
        <servlet-class>com.hrm.project.controller.common.AdminInsuranceConfig</servlet-class>
        <init-param>
            <param-name>charset</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </servlet>

    <!-- URL Mapping: GET /admin/insurance -->
    <servlet-mapping>
        <servlet-name>AdminInsuranceConfig</servlet-name>
        <url-pattern>/admin/insurance</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminInsuranceConfig</servlet-name>
        <url-pattern>/hr/insurance</url-pattern>
    </servlet-mapping>

    <!-- URL Mapping: POST /admin/insurance/action -->
    <servlet-mapping>
        <servlet-name>AdminInsuranceConfig</servlet-name>
        <url-pattern>/admin/insurance/action</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminInsuranceConfig</servlet-name>
        <url-pattern>/hr/insurance/action</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
